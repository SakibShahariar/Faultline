[Unit]
Description=Faultline optional resource sampler
Documentation=https://github.com/SakibShahariar/Faultline
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/faultline sampler
Restart=on-failure
RestartSec=10
Nice=10
CPUQuota=5%
MemoryMax=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/faultline
