[Unit]
Description=Faultline optional resource sampler
Documentation=https://github.com/SakibShahariar/Faultline
After=default.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/env faultline sampler
Restart=on-failure
RestartSec=10
Nice=10
CPUQuota=5%
MemoryMax=64M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/faultline

[Install]
WantedBy=default.target
